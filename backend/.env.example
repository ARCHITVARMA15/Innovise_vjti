# Official SEC retrieval: application name plus a real contact email.
# SEC_USER_AGENT=Veritas Research Lab your-real-contact@example.com

# Analyst Watch: backend only. Never use NEXT_PUBLIC_* for these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Compatibility alias used only when TWILIO_WHATSAPP_FROM is blank:
TWILIO_WHATSAPP_NUMBER=
# The single allowlisted recipient (E.164, with optional whatsapp: prefix).
TWILIO_WHATSAPP_TO=
# Optional approved, relevant financial DEMO template; see docs/analyst-watch.md.
TWILIO_CONTENT_SID=
# Optional HTTPS public application URL. No localhost/private-address links are sent.
PUBLIC_APP_URL=
# Legacy compatibility setting; no longer required to attempt a verified reply-window send.
# Account and recent inbound-message checks still apply; Twilio enforces content eligibility.
TWILIO_LEGACY_SANDBOX_BODY=0
# Extra exact browser origins for a local demo, comma-separated. Defaults allow localhost:3000.
ANALYST_WATCH_ALLOWED_ORIGINS=
# Optional existing Research Lab storage directory. Watch uses a separate database there.
# VERITAS_RESEARCH_DIR=/absolute/path/to/local-demo-data

# WhatsApp message mode (server configured): financial_alert | trial_delivery_demo
# financial_alert preserves custom Body / approved financial-template messaging.
TWILIO_NOTIFICATION_MODE=financial_alert
# Trial delivery demo uses the exact predefined sample from the Console.
# This is independent of TWILIO_CONTENT_SID used by financial_alert mode.
TWILIO_TRIAL_CONTENT_SID=
# Static expected Console variables only. {} means omit ContentVariables entirely.
# Never substitute revenue, margin, alerts or event IDs into unrelated sample fields.
TWILIO_TRIAL_CONTENT_VARIABLES={}

# Insights agent model overrides (independent of Research Lab model settings).
# Choose models available to your configured provider/account.
INSIGHTS_MODEL=openai/gpt-oss-20b
INSIGHTS_ROUTER_MODEL=openai/gpt-oss-20b
INSIGHTS_FALLBACK_MODEL=openai/gpt-oss-20b
